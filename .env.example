# Orbit 部署地址（后端 Python SDK 与浏览器端 Node SDK 共用）
ORBIT_BASE_URL=https://support.example.com
# Orbit API token（类型 API Client，scope 仅需 agent_chat:write）。只给后端用，绝不下发到浏览器。
ORBIT_API_TOKEN=replace-me

# 可选：后端监听地址 / 前端访问后端的地址
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
# 可选：浏览器页面的 origin，后端 CORS 放行用（前端经 Next.js 代理访问时无需改动）
FRONTEND_ORIGIN=http://localhost:3000
# 可选：true 时浏览器经 Next.js 的 /orbit/* 代理访问 Orbit，本地开发可免去在 Orbit 配置 CORS origin
ORBIT_BROWSER_PROXY=false
